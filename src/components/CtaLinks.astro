---
interface Props {
  walkthrough_url?: string;
  article_url?: string;
  demo_url?: string;
}

const { walkthrough_url, article_url, demo_url } = Astro.props;
const links = [
  walkthrough_url && { href: walkthrough_url, label: 'Open walkthrough', primary: true },
  article_url && { href: article_url, label: 'Read article', primary: !walkthrough_url },
  demo_url && { href: demo_url, label: 'View demo', primary: false },
].filter(Boolean) as { href: string; label: string; primary: boolean }[];
---

{links.length > 0 && (
  <div class="cta-links">
    {links.map((link) => (
      <a
        href={link.href}
        class={link.primary ? undefined : 'cta--secondary'}
        rel="noopener noreferrer"
        target="_blank"
      >
        {link.label}
      </a>
    ))}
  </div>
)}
