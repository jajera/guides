---
import BaseLayout from '../layouts/BaseLayout.astro';
import EntryMeta from '../components/EntryMeta.astro';
import CtaLinks from '../components/CtaLinks.astro';
import { getPublishedGuides, type GuideEntry } from '../lib/guides';

export async function getStaticPaths() {
  const entries = await getPublishedGuides();
  return entries.map((entry) => ({
    params: { slug: entry.slug },
    props: { entry },
  }));
}

interface Props {
  entry: GuideEntry;
}

const { entry } = Astro.props;
const { Content } = await entry.render();
const {
  title,
  summary,
  type,
  category,
  date,
  tags,
  walkthrough_url,
  article_url,
  demo_url,
  video_url,
  social_url,
} = entry.data;
---

<BaseLayout title={title} description={summary}>
  <article>
    <EntryMeta type={type} category={category} date={date} tags={tags} showTags={true} />
    <h1 class="page-title" style="margin-top: 1rem;">{title}</h1>
    <p class="page-lede">{summary}</p>
    <div class="prose">
      <Content />
    </div>
    <CtaLinks
      walkthrough_url={walkthrough_url}
      article_url={article_url}
      demo_url={demo_url}
      video_url={video_url}
      social_url={social_url}
    />
  </article>
</BaseLayout>
