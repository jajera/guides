---
import { getCollection, type CollectionEntry } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import EntryMeta from '../components/EntryMeta.astro';
import CtaLinks from '../components/CtaLinks.astro';

export async function getStaticPaths() {
  const entries = await getCollection('guides', ({ data }) => !data.draft);
  return entries.map((entry) => ({
    params: { slug: entry.slug },
    props: { entry },
  }));
}

interface Props {
  entry: CollectionEntry<'guides'>;
}

const { entry } = Astro.props;
const { Content } = await entry.render();
const { title, summary, type, category, date, tags, walkthrough_url, article_url, demo_url } = entry.data;
---

<BaseLayout title={title} description={summary}>
  <article>
    <EntryMeta type={type} category={category} date={date} tags={tags} showTags={true} />
    <h1 class="page-title" style="margin-top: 1rem;">{title}</h1>
    <p class="page-lede">{summary}</p>
    <div class="prose">
      <Content />
    </div>
    <CtaLinks walkthrough_url={walkthrough_url} article_url={article_url} demo_url={demo_url} />
  </article>
</BaseLayout>
